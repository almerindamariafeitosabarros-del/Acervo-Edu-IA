# ---------------------------------------------------------------------------
# Acervo Edu IA - exemplo de configuracao. Copie para .env e ajuste os valores.
# ---------------------------------------------------------------------------

# Django
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (PostgreSQL via Docker Compose)
POSTGRES_DB=acervo_edu_ia
POSTGRES_USER=acervo
POSTGRES_PASSWORD=acervo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Use True apenas para rodar testes/demonstracao sem Docker (banco SQLite local)
USE_SQLITE=False

# CORS - origens do frontend (separe por vírgula se houver mais de uma)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Tokens JWT (minutos / dias)
ACCESS_TOKEN_LIFETIME_MINUTES=60
REFRESH_TOKEN_LIFETIME_DAYS=7

# Upload de arquivos
MAX_UPLOAD_SIZE_MB=25

# Assistente de IA (Ollama local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AI_MAX_CHARS=12000
AI_TIMEOUT_SECONDS=120
